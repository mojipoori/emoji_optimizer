[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://github.com/mojipoori/fairseq.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
	vscode-merge-base = origin/main
[remote "upstream"]
	url = https://github.com/facebookresearch/fairseq.git
	fetch = +refs/heads/*:refs/remotes/upstream/*
[branch "emoji-experiments-v0.12.2"]
	vscode-merge-base = origin/main
	remote = origin
	merge = refs/heads/emoji-experiments-v0.12.2
